services:
  adminer:
    container_name: docker-adminer
    image: adminer:latest
    restart: always
    ports:
      - 8080:8080
    networks:
      - default

  phpmyadmin:
    image: phpmyadmin:latest
    container_name: dev-phpmyadmin
    ports:
      - "8081:80"
    environment:
      PMA_HOST: mysql
      UPLOAD_LIMIT: 300M
      MEMORY_LIMIT: 512M
      MAX_EXECUTION_TIME: 0
    networks:
      - default
    restart: always

  maildev:
    container_name: docker-maildev
    image: maildev/maildev:latest
    restart: always
    ports:
      - 1080:1080
      - 1025:1025
    networks:
      - default

  portainer:
    container_name: docker-portainer
    image: portainer/portainer-ce:latest
    restart: always
    ports:
      - 9000:9000
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ../docker-volumes/portainer-data:/data
    networks:
      - default

  minio:
    container_name: docker-minio
    image: quay.io/minio/minio
    restart: always
    ports:
      - 1090:9000
      - 1091:9001
    volumes:
      - ../docker-volumes/minio-data:/data
    environment:
      - MINIO_ROOT_USER=admin
      - MINIO_ROOT_PASSWORD=admin12345678
    networks:
      - default
    command: server /data --console-address ":9001"
