# Check your uid:gid at your terminal with command = id -u : id -g
# For example, if your uid is 1000 and gid is 1000, then set like below:
# Copy this file to .env and set your uid and gid
UID=your uid host user
GID=your gid host user

# --- SERVER ONLY ---
# Aktifkan untuk pakai Caddy di server (domain + HTTPS otomatis)
# COMPOSE_PROFILES=server

# Bind nginx ke localhost biar cuma bisa diakses Caddy
NGINX_HTTP=127.0.0.1:8080:80
NGINX_HTTPS=127.0.0.1:8443:443

# Bind node24 ke localhost biar cuma bisa diakses via domain lewat Caddy
NODE24_PORT=127.0.0.1:3024:3000

# OAuth credentials (isi agar provider aktif, kosongkan untuk nonaktif)
# Google: https://console.cloud.google.com/apis/credentials
# redirect URI: http://localhost:54320/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
# callback URL: http://localhost:54320/auth/v1/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
