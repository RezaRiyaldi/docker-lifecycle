# UID/GID host user. Check with: id -u && id -g
UID=1000
GID=1000

# Local defaults: Caddy is disabled and services use their normal local ports.
# Set COMPOSE_PROFILES=server and override the ports below only on a server.
COMPOSE_PROFILES=
NGINX_HTTP=
NGINX_HTTPS=
NODE24_PORT=

# --- LOCAL stack credentials ---
LOCAL_POSTGRES_PASSWORD=
LOCAL_REDIS_PASSWORD=
LOCAL_MYSQL_ROOT_PASSWORD=
LOCAL_MYSQL_PASSWORD=
LOCAL_MYSQL57_ROOT_PASSWORD=
LOCAL_MYSQL57_PASSWORD=
LOCAL_RADIUS_SECRET=
LOCAL_RADIUS_DB_PASSWORD=
LOCAL_RUSTFS_ROOT_USER=
LOCAL_RUSTFS_ROOT_PASSWORD=
LOCAL_MINIO_AISTOR_ROOT_USER=
LOCAL_MINIO_AISTOR_ROOT_PASSWORD=

# --- QA stack credentials ---
QA_POSTGRES_PASSWORD=
QA_REDIS_PASSWORD=
QA_MYSQL_ROOT_PASSWORD=
QA_MYSQL_PASSWORD=
QA_MYSQL57_ROOT_PASSWORD=
QA_MYSQL57_PASSWORD=
QA_RUSTFS_ROOT_USER=
QA_RUSTFS_ROOT_PASSWORD=
QA_MINIO_AISTOR_ROOT_USER=
QA_MINIO_AISTOR_ROOT_PASSWORD=
QA_RADIUS_SECRET=
QA_RADIUS_DB_PASSWORD=
